{
  "name": "pluvix",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "build:alertas": "esbuild api/alertas.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-lambda/alertas/index.js",
    "build:suscripciones": "esbuild api/suscripciones.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-lambda/suscripciones/index.js",
    "build:notificador": "esbuild api/notificador.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-lambda/notificador/index.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/lib-dynamodb": "^3.1164.0",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "kafkajs": "^2.2.4",
    "nodemailer": "^10.4.0",
    "typescript": "^7.0.2"
  }
